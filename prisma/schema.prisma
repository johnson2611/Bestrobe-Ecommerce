// Prisma schema for order persistence, using Neon (Postgres).
// Run `npx prisma db push` after setting DATABASE_URL to create these tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model Order {
  id           String      @id @default(cuid())
  reference    String      @unique // Paystack transaction reference
  email        String
  amount       Int         // total paid, in NGN (whole naira, not kobo)
  status       String      // "success" | "failed" (mirrors Paystack's verify response)
  createdAt    DateTime    @default(now())
  items        OrderItem[]

  @@index([email])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name       String
  size       String
  price      Int     // unit price in NGN at time of purchase
  quantity   Int
}
